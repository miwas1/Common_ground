# Development-only, non-secret defaults (committed). Secrets go in .env.local.

# Workflow SDK: how long a step's previous owner is assumed alive before the step is retried.
# The 860s default is sized for Vercel function lifetimes; locally a crashed dev server
# should resume a research run within seconds.
WORKFLOW_INLINE_OWNERSHIP_LEASE_SECONDS=20

# Better Auth: public origin of the dev server (production sets its own).
BETTER_AUTH_URL=http://localhost:3000
