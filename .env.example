# Copy to .env.local and fill in. Never commit real values.

# Qloo hackathon key — only valid against the hackathon base URL
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Postgres — private Qloo cache, provenance, campaigns.
# Leave DATABASE_URL empty locally: the app uses embedded PGlite in ./.pglite
# (migrated automatically). Set it to the Neon connection string in production.
DATABASE_URL=
# PGLITE_DATA_DIR=./.pglite   # or memory:// for a throwaway database

# Agent model
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Better Auth: session signing secret (generate with `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public origin. Optional on Vercel (derived from system env vars); set it for a custom domain.
BETTER_AUTH_URL=http://localhost:3000

# Password for the seeded demo accounts (`pnpm db:seed`); one-click demo sign-in uses it server-side.
DEMO_PASSWORD=
